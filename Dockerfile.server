# syntax=docker/dockerfile:1
# 与当前 Ubuntu 24.04 服务器的 Python 3.12 ABI 对齐，不安装 PyTorch/CUDA。
FROM node:24-bookworm-slim AS frontend
WORKDIR /build/web
COPY web/package.json web/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY web/ ./
RUN npm run build

FROM ubuntu:24.04
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONUTF8=1 HOME=/tmp \
    OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
RUN apt-get update && apt-get install -y --no-install-recommends python3.12 libgomp1 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY scripts/serve_web.py scripts/validate_gpu.py /opt/cls/scripts/
COPY --from=frontend /build/web/dist /opt/cls/web/dist/
USER 1000:1000
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD /usr/bin/python3.12 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=4).read()"
