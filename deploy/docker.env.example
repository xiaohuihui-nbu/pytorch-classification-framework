# 复制为项目根目录 .env，并使用部署用户的 id -u / id -g。
CLS_UID=1000
CLS_GID=1000
CLS_PORT=8000
CLS_WEB_PORT=5173
# 默认经 SSH 隧道访问；已有局域网部署可将两项改为服务器局域网 IP。
CLS_BIND_IP=127.0.0.1
CLS_ALLOWED_HOST=127.0.0.1
# 从其他局域网地址通过隧道访问时，显式添加浏览器来源；不要使用通配符。
CLS_WEB_ORIGINS=
# 新部署可保留 /workspace；迁移已有任务时必须与原服务器绝对路径相同。
CLS_WORKSPACE=/workspace
# configs/data/weights/cache/runs/logs 的宿主机父目录。
CLS_DATA_ROOT=.
