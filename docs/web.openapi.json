  "components": {
    "schemas": {
      "Appearance": {
        "properties": {
          "theme": {
            "type": "string",
            "enum": [
              "cyber",
              "forest",
              "ocean",
              "violet",
              "amber"
            ],
            "title": "Theme",
            "default": "cyber"
          },
          "mode": {
            "type": "string",
            "enum": [
              "light",
              "dark",
              "system"
            ],
            "title": "Mode",
            "default": "dark"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Appearance"
      },
      "Body_upload_api_uploads_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_api_uploads_post"
      },
      "Concurrency": {
        "properties": {
          "train": {
            "type": "integer",
            "maximum": 8.0,
            "minimum": 0.0,
            "title": "Train",
            "description": "0 表示不限制训练任务数量",
            "default": 0
          },
          "predict": {
            "type": "integer",
            "maximum": 8.0,
            "minimum": 1.0,
            "title": "Predict",
            "default": 1
          },
          "auxiliary": {
            "type": "integer",
            "maximum": 4.0,
            "minimum": 1.0,
            "title": "Auxiliary",
            "default": 1
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Concurrency"
      },
      "EvaluateRequest": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "priority": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Priority",
            "default": 0
          },
          "timeout_minutes": {
            "type": "integer",
            "maximum": 10080.0,
            "minimum": 0.0,
            "title": "Timeout Minutes",
            "default": 0
          },
          "split": {
            "type": "string",
            "enum": [
              "val",
              "test"
            ],
            "title": "Split",
            "default": "val"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "run_id"
        ],
        "title": "EvaluateRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Inference": {
        "properties": {
          "resident": {
            "type": "boolean",
            "title": "Resident",
            "default": true
          },
          "cpu_threads": {
            "type": "integer",
            "maximum": 32.0,
            "minimum": 1.0,
            "title": "Cpu Threads",
            "default": 2
          },
          "batch_size": {
            "type": "integer",
            "maximum": 64.0,
            "minimum": 1.0,
            "title": "Batch Size",
            "default": 8
          },
          "cache_models": {
            "type": "integer",
            "maximum": 4.0,
            "minimum": 1.0,
            "title": "Cache Models",
            "default": 1
          },
          "cache_mb": {
            "type": "integer",
            "maximum": 2048.0,
            "minimum": 16.0,
            "title": "Cache Mb",
            "default": 256
          },
          "idle_seconds": {
            "type": "integer",
            "maximum": 3600.0,
            "minimum": 30.0,
            "title": "Idle Seconds",
            "default": 300
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Inference"
      },
      "JobDelete": {
        "properties": {
          "job_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 200,
            "minItems": 1,
            "title": "Job Ids"
          },
          "stop_running": {
            "type": "boolean",
            "title": "Stop Running",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "job_ids"
        ],
        "title": "JobDelete"
      },
      "JobEdit": {
        "properties": {
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "parameters": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parameters"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "JobEdit"
      },
      "PredictRequest": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "priority": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Priority",
            "default": 0
          },
          "timeout_minutes": {
            "type": "integer",
            "maximum": 10080.0,
            "minimum": 0.0,
            "title": "Timeout Minutes",
            "default": 0
          },
          "uploads": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Uploads"
          },
          "top_k": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Top K",
            "default": 5
          },
          "save_images": {
            "type": "boolean",
            "title": "Save Images",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "run_id",
          "uploads"
        ],
        "title": "PredictRequest"
      },
      "Resources": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "default": true
          },
